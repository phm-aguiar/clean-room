{
  "description": "session_id que não é UUID: vira UUID v5 no namespace OID, determinístico (LEI §3.3).",
  "input": {"agent": "claude-code", "event": "user-prompt", "cwd": "", "session_id": ""},
  "body": {
    "session_id": "sess-abc",
    "cwd": "/work/project-a",
    "prompt": "oi"
  },
  "expect": {
    "hook": "user-prompt",
    "has_session": true,
    "session_id": "edcd8bca-e4d0-5632-85c8-99dcb1f7c4f0",
    "occurred_at": "now"
  }
}
