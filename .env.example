# Copie para .env (não versionado) e ajuste. Nenhum segredo deve ser colocado aqui.
# Precedência (INV-01): padrões < TOML < .env < variáveis do processo. Separador de níveis: "__".

# --- Feature 001: núcleo ---
# Diretório de dados (wiki/ e db/). Padrão: data. Aceita caminho relativo (canonizado a partir do diretório de trabalho) ou absoluto; o caminho final é registrado no log.
AI_MEMORY_DATA_DIR=./data
# Nível de log. Padrão: info. Valores aceitos: debug|info|warn|error
AI_MEMORY_LOG__LEVEL=info
# Debounce do watcher da wiki, em milissegundos. Padrão: 300. Aceita inteiro positivo.
AI_MEMORY_WIKI__WATCH_DEBOUNCE_MS=300
# Intervalo da reconciliação da wiki, em segundos. Padrão: 30. Aceita inteiro positivo.
AI_MEMORY_WIKI__RECONCILE_INTERVAL_S=30
